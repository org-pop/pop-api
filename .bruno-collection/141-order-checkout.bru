meta {
  name: 141-order-checkout
  type: http
  seq: 141
}
post {
  url: {{baseUrl}}/orders/{{userId_a}}/checkout
  body: none
  auth: none
}
headers {
  Authorization: Bearer {{token_a}}
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("orderId", res.body.id);
  }
}
