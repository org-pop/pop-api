meta {
  name: 131-cart-add
  type: http
  seq: 131
}
post {
  url: {{baseUrl}}/cart/{{userId_a}}/add/{{productId}}?quantity=2
  body: none
  auth: none
}
headers {
  Authorization: Bearer {{token_a}}
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("cartItemId", res.body.id);
  }
}
