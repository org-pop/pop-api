meta {
  name: v11-payment-create
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/payments/order/{{orderId}}?method=CREDIT_CARD
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_a}}
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("paymentId", res.body.id);
  }
}
